# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection. On Vercel + Neon/Supabase use the pooled URL here…
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# …and the direct (non-pooled) URL here, used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Signs session cookies and order links. Generate: openssl rand -hex 32
SESSION_SECRET=

# Public base URL (canonical URLs, sitemap, emails).
NEXT_PUBLIC_SITE_URL=https://osatechstore.com

# First admin account, created by the seed if it doesn't exist (min 10 chars).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Optional integrations ───────────────────────────────────────────────────
# Product image uploads (Vercel → Storage → Blob). Required for uploads in production.
BLOB_READ_WRITE_TOKEN=

# Transactional email via Resend (order confirmations, password resets, staff alerts).
RESEND_API_KEY=
EMAIL_FROM="OSA Techstore <orders@yourdomain.com>"
