# ─── Required ────────────────────────────────────────────────────────────────
# Postgres connection. If you connect Neon or Supabase through Vercel → Storage,
# their variables (POSTGRES_PRISMA_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED,
# POSTGRES_URL_NON_POOLING) are picked up automatically — you can skip these two.
# Otherwise use the pooled URL here…
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# …and the direct (non-pooled) URL here, used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# Optional: signs session cookies and order links (otherwise derived from the
# database URL). Generate: openssl rand -hex 32
SESSION_SECRET=

# Public base URL (canonical URLs, sitemap, emails).
NEXT_PUBLIC_SITE_URL=https://osatechstore.com

# Optional: first admin login (min 10 chars). If omitted, the first deploy creates
# admin@osatechstore.com with a random password printed in the build log.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Optional integrations ───────────────────────────────────────────────────
# Product image uploads (Vercel → Storage → Blob). Required for uploads in production.
BLOB_READ_WRITE_TOKEN=

# Receipt emails to customers (and new-order alerts to the store) via Resend.
RESEND_API_KEY=
EMAIL_FROM="OSA Techstore <orders@yourdomain.com>"

# Automatic WhatsApp order confirmations via the WhatsApp Cloud API (Meta).
# Requires an approved template (default name "order_confirmation") with 4 body
# variables: {{1}} first name, {{2}} order number, {{3}} items, {{4}} total.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=order_confirmation
WHATSAPP_TEMPLATE_LANG=en
