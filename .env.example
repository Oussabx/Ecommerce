# Public base URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://osatechstore.com

# Secret used to sign session cookies and order-access tokens.
# Generate with: openssl rand -hex 32   (REQUIRED in production)
SESSION_SECRET=

# Directory for the demo JSON data store (orders, users, messages, subscribers).
# Replace the store in src/server/store.ts with a real database before launch.
DATA_DIR=./data
